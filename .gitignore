__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/
build/
dist/
.venv/
venv/

# Tržní data a stav paper účtu — patří lokálně, ne do repozitáře
data/cache/
data/*.json
data/*.tmp
*.csv
!tests/**/*.csv
# Kalendář událostí je ručně opsaný ze zdrojů, žádný build ho neobnoví —
# na rozdíl od cache s tržními daty do repozitáře patří.
!data/udalosti.csv
!data/udalosti-vzor.csv
# Vzor účetní knihy patří do repozitáře; data/portfolio.csv se skutečnými
# obchody schválně ne — vaše pozice nejsou nikoho jiného věc.
!data/portfolio-vzor.csv
# Totéž pro paměť hlídače a jeho log: je z nich vidět, co držíte a kdy.
data/hlidac_stav.json
data/hlidac*.log
# Seznam sledovaných titulů je osobní; do gitu jde jen vzor.
data/sledovane.txt
# Kontakt pro SEC (jméno a e-mail) — osobní údaj.
data/sec_kontakt.txt
